DATABASE_URL="mysql://root:password@localhost:3307/wp_ad_community"
PORT=4100
PUBLIC_BASE_URL="http://localhost:4100/v1"
CORS_ORIGINS="*"
NODE_ENV=development

# Required in production for /v1/admin/* endpoints.
ADMIN_TOKEN="change-me"

# Required in production for signed legacy event endpoints (optional browser paths).
EVENT_TOKEN_SECRET="change-me"
EVENT_TRACKING_ENABLED=true
# Prefer rollups + counters only (production cost default).
RAW_EVENTS_ENABLED=false

ROTATION_CACHE_TTL_MS=300000
ROTATION_CACHE_WARM_ON_START=true

EVENT_FLUSH_INTERVAL_MS=2000
EVENT_FLUSH_MAX_BATCH=500
EVENT_MAX_QUEUE=5000
EVENT_FLUSH_LOG_THROTTLE_MS=30000
SHUTDOWN_TIMEOUT_MS=10000

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_SERVE_MAX=600
RATE_LIMIT_EVENTS_MAX=2000
RATE_LIMIT_WRITE_MAX=120
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_ADMIN_MAX=120
# Cap in-memory rate-limit map size on small instances.
RATE_LIMIT_MAX_BUCKETS=10000

REJECT_PRIVATE_URLS_IN_PRODUCTION=true

# Public marketing site origin (defaults to PUBLIC_BASE_URL without /v1).
# PUBLIC_SITE_URL="http://localhost:4100"

# Soft-launch inventory seed (local or Railway staging). Requires exact value "1".
# ALLOW_SOFT_LAUNCH_SEED=1

# Optional ZIP/GitHub release URL for the public /plugin download button.
# PLUGIN_DOWNLOAD_URL="https://github.com/org/wp-advertising/releases/latest/download/wp-advertising.zip"

# Stripe Checkout (P3). Leave unset to keep CHECKOUT_NOT_CONFIGURED.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PRICE_MONTHLY="price_..."
# STRIPE_PRICE_ANNUAL="price_..."

# Optional smoke test overrides.
SMOKE_BASE_URL="http://localhost:4100/v1"
SMOKE_SITE_URL="https://smoke-source.example.com"
SMOKE_OTHER_SITE_URL="https://smoke-target.example.com"
